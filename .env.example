PORT=8080
ENV=development
REDIS_ADDR=localhost:6379
REDIS_MASTER_NAME=
REDIS_SENTINEL_ADDRS=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=500ms
REDIS_READ_TIMEOUT=200ms
REDIS_WRITE_TIMEOUT=200ms
RATE_LIMIT_DECISION_TIMEOUT=300ms
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_OPEN_TIMEOUT=5s
RATE_LIMIT_EVENT_STREAM=rate_limit:approved_requests
RATE_LIMIT_EVENT_MAX_BACKLOG=100000
DATABASE_URL=postgres://rate_limiter:rate_limiter@localhost:5433/rate_limiter?sslmode=disable
APPROVAL_WORKER_GROUP=approval-history
APPROVAL_WORKER_CONSUMER=
APPROVAL_WORKER_BATCH_SIZE=100
APPROVAL_WORKER_BLOCK=1s
APPROVAL_WORKER_CLAIM_IDLE=30s
APPROVAL_WORKER_CLAIM_INTERVAL=10s
APPROVAL_WORKER_RETRY_BACKOFF=1s
WORKER_PORT=8081
APPROVAL_WORKER_STATUS_INTERVAL=5s
APPROVAL_WORKER_BACKLOG_WARNING_PERCENT=80
